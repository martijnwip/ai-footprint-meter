---
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
---

<section aria-label={t.chatMockup.ariaLabel} class="hero-wrap pb-[clamp(56px,10vw,96px)]">
  <p class="mt-0 mb-[18px] text-[14px] text-muted">{t.chatMockup.caption}</p>

  <div class="flex h-[600px] overflow-hidden rounded-lg border border-line bg-card">
    <!-- Zijbalk -->
    <div
      class="hidden w-[190px] shrink-0 flex-col border-r border-line px-4 py-5 min-[720px]:flex"
    >
      <div class="mb-[18px] text-[15px] font-bold">{t.chatMockup.sidebarBrand}</div>
      <div class="mb-5 rounded-[5px] bg-ink px-3 py-[9px] text-[13px] font-semibold text-paper">
        {t.chatMockup.newChat}
      </div>
      <div class="mb-2.5 text-[11px] tracking-[0.1em] text-muted uppercase">{t.chatMockup.recentLabel}</div>
      <div class="mb-1.5 rounded-[5px] bg-paper px-2.5 py-2">
        <div class="text-[13px] font-semibold">{t.chatMockup.chatTitle1}</div>
        <div class="mt-0.5 text-[12px] text-accent">{t.chatMockup.chatUsage1}</div>
      </div>
      <div class="px-2.5 py-2">
        <div class="text-[13px] text-ink">{t.chatMockup.chatTitle2}</div>
        <div class="mt-0.5 text-[12px] text-muted">{t.chatMockup.chatUsage2}</div>
      </div>
    </div>

    <!-- Gesprek -->
    <div class="flex-1 overflow-y-auto px-4 py-5 min-[720px]:px-7 min-[720px]:py-6">
        <div class="mb-[18px] flex justify-end">
          <div
            class="max-w-[340px] rounded-md bg-ink px-3.5 py-2.5 text-[14px] leading-normal text-paper"
          >
            {t.chatMockup.userMessage}
          </div>
        </div>

        <p class="mt-0 mb-3.5 text-[14px] leading-relaxed text-ink">
          {t.chatMockup.assistantReply}
        </p>

        <div
          class="mb-[22px] flex max-w-[280px] items-center gap-3 rounded-md border border-line px-3.5 py-3"
        >
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="#FAF9F5" aria-hidden="true">
              <polygon points="5,3 21,12 5,21"></polygon>
            </svg>
          </span>
          <div>
            <div class="text-[13px] font-semibold">{t.chatMockup.attachmentTitle}</div>
            <div class="text-[12px] text-muted">{t.chatMockup.attachmentMeta}</div>
          </div>
        </div>

        <details class="group max-w-[420px]" open>
          <summary class="flex w-fit cursor-pointer list-none items-center gap-2.5 [&::-webkit-details-marker]:hidden">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center text-muted" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="8" y="8" width="12" height="12" rx="1.5"></rect>
                <path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"></path>
              </svg>
            </span>
            <span class="flex h-7 w-7 shrink-0 items-center justify-center text-muted" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M3 12a9 9 0 1 1 2.6 6.3"></path>
                <polyline points="3 17 3 12 8 12"></polyline>
              </svg>
            </span>
            <span class="flex items-center gap-1.5 rounded-full border border-line px-3.5 py-[7px] text-[13px] font-semibold">
              {t.chatMockup.statLabel}
              <svg
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                class="transition-transform duration-200 group-open:rotate-180"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>

          <div class="mt-4 rounded-md border border-line p-5">
            <div class="mb-4 flex flex-wrap items-baseline justify-between gap-3">
              <span class="text-[11px] font-bold tracking-[0.13em] uppercase">{t.chatMockup.statLabel}</span>
              <span class="text-[12px] text-muted">{t.chatMockup.statMeta}</span>
            </div>
            <div class="mb-3.5 flex items-baseline gap-2">
              <span class="text-[34px] leading-none font-bold text-accent">{t.meterCard.total}</span>
              <span class="text-[15px] font-semibold text-accent">{t.meterCard.unit}</span>
            </div>
            <div class="mb-4 flex flex-col gap-2">
              {
                t.chatMockup.rows.map((row, index) => (
                  <div class="flex items-center gap-2 text-[13px]">
                    <span class={`h-2 w-2 shrink-0 ${['bg-accent-soft', 'bg-accent-mid', 'bg-accent'][index]}`} />
                    <span class="flex-1">{row.label}</span>
                    <span class="text-muted">{row.value}</span>
                  </div>
                ))
              }
            </div>
            <div class="border-t border-line pt-3 text-[13px]">{t.chatMockup.sustainabilityNote}</div>
          </div>
        </details>
      </div>
    </div>
</section>
