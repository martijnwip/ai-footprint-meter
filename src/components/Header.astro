---
import { locales, getLocalizedPath } from '../i18n/utils';

const current = Astro.currentLocale ?? 'nl';
const pathname = Astro.url.pathname;
---

<header class="section-wrap flex justify-end gap-4 py-3 text-[13px]">
  {
    locales.map((locale) =>
      locale.code === current ? (
        <span class="font-semibold text-ink" aria-current="true">
          {locale.nativeLabel}
        </span>
      ) : (
        <a href={getLocalizedPath(pathname, current, locale.code)} class="text-muted hover:text-ink">
          {locale.nativeLabel}
        </a>
      ),
    )
  }
</header>
