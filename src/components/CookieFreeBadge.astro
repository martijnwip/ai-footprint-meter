---
---

<div
  data-cookie-free-badge
  style="display:none"
  class="fixed right-4 bottom-20 z-50 flex max-w-[280px] items-center gap-3 rounded-xl border border-line bg-card px-4 py-3 text-ink shadow-lg min-[720px]:right-6 min-[720px]:bottom-6"
>
  <span
    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-soft"
    aria-hidden="true"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="9" stroke="var(--color-accent)" stroke-width="1.6" />
      <circle cx="9" cy="10" r="1.1" fill="var(--color-accent)" />
      <circle cx="14" cy="9" r="1.1" fill="var(--color-accent)" />
      <circle cx="13" cy="14" r="1.1" fill="var(--color-accent)" />
      <circle cx="9.5" cy="14.5" r="1.1" fill="var(--color-accent)" />
    </svg>
  </span>

  <p class="m-0 flex-1 text-[13px] leading-[1.4]">Dit is een cookie-vrije omgeving.</p>

  <button
    type="button"
    data-cookie-free-dismiss
    aria-label="Melding sluiten"
    class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-muted hover:bg-line hover:text-ink"
  >
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path
        d="M1 1L11 11M11 1L1 11"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
      />
    </svg>
  </button>
</div>

<script>
  const KEY = 'cookie-free-notice-dismissed';
  const badge = document.querySelector<HTMLElement>('[data-cookie-free-badge]');
  const dismiss = document.querySelector<HTMLButtonElement>('[data-cookie-free-dismiss]');

  if (badge && !localStorage.getItem(KEY)) {
    badge.style.display = 'flex';
  }

  dismiss?.addEventListener('click', () => {
    if (badge) badge.style.display = 'none';
    localStorage.setItem(KEY, '1');
  });
</script>
