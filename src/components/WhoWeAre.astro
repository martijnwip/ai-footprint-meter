---
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
---

<section id="bronnen" aria-label={t.whoWeAre.ariaLabel} class="section-wrap py-[clamp(56px,10vw,96px)]">
  <h2 class="h2-title mt-0 mb-[26px]">{t.whoWeAre.heading}</h2>

  <p class="mt-0 mb-9 body-text">
    {t.whoWeAre.intro}
  </p>

  <div class="label-caps mb-3.5 text-muted">{t.whoWeAre.sourcesLabel}</div>
  <ul class="mt-0 mb-7 list-disc pl-5 text-[15px] leading-relaxed text-muted">
    {
      t.whoWeAre.sources.map((source, index) => (
        <li class={index === t.whoWeAre.sources.length - 1 ? '' : 'mb-2'}>
          {source.text}
          {source.em && <em>{source.em}</em>}
          {source.tail}
          <a href={source.href} target="_blank" rel="noopener">
            {source.label}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="m-0 text-[14px] leading-[1.5] text-muted">
    {t.whoWeAre.outroPrefix} <a
      href="mailto:aifootprintmeter@proton.me"
      class="text-[14px]">aifootprintmeter@proton.me</a
    >
  </p>
</section>
