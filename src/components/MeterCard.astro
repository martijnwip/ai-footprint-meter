---
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
---

<div
  class="max-w-[640px] rounded-md border border-line bg-card p-[clamp(20px,3.4vw,32px)]"
>
  <div class="mb-5 flex flex-wrap items-baseline justify-between gap-3">
    <span class="label-caps text-ink">{t.meterCard.label}</span>
    <span class="text-[13px] text-muted">{t.meterCard.meta}</span>
  </div>

  <div class="mb-1.5 flex items-baseline gap-2.5">
    <span class="text-[clamp(38px,7vw,52px)] leading-none font-bold text-accent">
      {t.meterCard.total}
    </span>
    <span class="text-[18px] font-semibold text-accent">{t.meterCard.unit}</span>
  </div>
  <p class="mt-0 mb-[18px] text-[14px] text-muted">{t.meterCard.caption}</p>

  <div class="mb-[22px] flex flex-col gap-2.5">
    {
      t.meterCard.rows.map((row, index) => (
        <div class="flex items-center gap-2.5 text-[15px]">
          <span class={`h-[9px] w-[9px] shrink-0 ${['bg-accent-soft', 'bg-accent-mid', 'bg-accent'][index]}`} />
          <span class="flex-1">{row.label}</span>
          <span class="text-[14px] text-muted">{row.value}</span>
        </div>
      ))
    }
  </div>

  <p class="mt-0 mb-3 text-[13px] tracking-[0.02em] text-muted">{t.meterCard.comparisonLabel}</p>
  <div class="flex flex-wrap gap-2.5">
    <div class="min-w-[140px] flex-1 rounded-[5px] bg-paper p-3.5">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3F6B47" stroke-width="1.6" aria-hidden="true">
        <rect x="4" y="3" width="16" height="18" rx="2"></rect>
        <circle cx="12" cy="13" r="5"></circle>
        <circle cx="12" cy="13" r="1.4"></circle>
        <line x1="8" y1="6" x2="10" y2="6"></line>
      </svg>
      <div class="mt-2.5 mb-0.5 text-[22px] font-bold">{t.meterCard.comparisons[0].value}</div>
      <div class="text-[13px] text-muted">{t.meterCard.comparisons[0].label}</div>
    </div>
    <div class="min-w-[140px] flex-1 rounded-[5px] bg-paper p-3.5">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3F6B47" stroke-width="1.6" aria-hidden="true">
        <path d="M4 16l1.5-5.5A2 2 0 0 1 7.4 9h9.2a2 2 0 0 1 1.9 1.5L20 16"></path>
        <rect x="3" y="16" width="18" height="4" rx="1"></rect>
        <circle cx="7.5" cy="20" r="1.3"></circle>
        <circle cx="16.5" cy="20" r="1.3"></circle>
      </svg>
      <div class="mt-2.5 mb-0.5 text-[22px] font-bold">{t.meterCard.comparisons[1].value}</div>
      <div class="text-[13px] text-muted">{t.meterCard.comparisons[1].label}</div>
    </div>
    <div class="min-w-[140px] flex-1 rounded-[5px] bg-paper p-3.5">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3F6B47" stroke-width="1.6" aria-hidden="true">
        <rect x="6" y="2" width="12" height="20" rx="1.5"></rect>
        <line x1="6" y1="10" x2="18" y2="10"></line>
        <line x1="9" y1="5" x2="9" y2="7"></line>
        <line x1="9" y1="13" x2="9" y2="15"></line>
      </svg>
      <div class="mt-2.5 mb-0.5 text-[22px] font-bold">{t.meterCard.comparisons[2].value}</div>
      <div class="text-[13px] text-muted">{t.meterCard.comparisons[2].label}</div>
    </div>
  </div>
</div>
