---
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
---

<section aria-label={t.objections.ariaLabel} class="section-wrap py-[clamp(56px,10vw,96px)]">
  <h2 class="h2-title mt-0 mb-[26px]">{t.objections.heading}</h2>

  {/* <details> in plaats van JavaScript: werkt zonder script en is toetsenbordvriendelijk */}
  {
    t.objections.faqs.map((faq) => (
      <details class="group border-t border-line">
        <summary
          class="flex cursor-pointer list-none items-center justify-between gap-4 py-[22px] text-[17px] font-bold [&::-webkit-details-marker]:hidden"
        >
          <span>{faq.q}</span>
          <span
            class="shrink-0 text-[22px] leading-none text-accent transition-transform duration-150 group-open:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p class="mt-0 mb-[26px] max-w-[66ch] body-text">{faq.a}</p>
      </details>
    ))
  }
</section>
