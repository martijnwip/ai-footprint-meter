---
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
---

<section aria-label={t.notNew.ariaLabel} class="section-wrap py-[clamp(56px,10vw,96px)]">
  <h2 class="h2-title mt-0 mb-[26px]">{t.notNew.heading}</h2>

  <p class="mt-0 mb-[22px] body-text">
    {t.notNew.p1}
  </p>
  <p class="mt-0 mb-[22px] body-text">
    {t.notNew.p2}
  </p>
  <p class="mt-0 mb-10 body-text">
    {t.notNew.p3}
  </p>

  <div class="mb-11 flex flex-wrap gap-7">
    <div class="text-center">
      <div
        class="mx-auto mb-2.5 flex h-[76px] w-[52px] flex-col items-center justify-center gap-0.5 rounded-[3px] border-[1.5px] border-ink py-1"
        aria-hidden="true"
      >
        <span class="text-[9px] font-bold">A</span>
        <span class="text-[9px] font-bold">B</span>
        <span class="text-[9px] font-bold">C</span>
        <span class="text-[9px] font-bold">D</span>
      </div>
      <div class="text-[13px] font-semibold">{t.notNew.euLabel}</div>
      <div class="text-[13px] text-muted">{t.notNew.euSince}</div>
    </div>

    <div class="text-center">
      <div
        class="mx-auto mb-2.5 flex h-[26px] w-[110px] rounded-[3px] border-[1.5px] border-ink"
        aria-hidden="true"
      >
        <span class="flex flex-1 items-center justify-center border-r border-ink text-[11px] font-bold">A</span>
        <span class="flex flex-1 items-center justify-center border-r border-ink text-[11px] font-bold">B</span>
        <span
          class="flex flex-1 items-center justify-center border-r border-ink bg-ink text-[11px] font-bold text-paper"
          >C</span
        >
        <span class="flex flex-1 items-center justify-center border-r border-ink text-[11px] font-bold">D</span>
        <span class="flex flex-1 items-center justify-center text-[11px] font-bold">E</span>
      </div>
      <div class="text-[13px] font-semibold">{t.notNew.nutriScore}</div>
      <div class="text-[13px] text-muted">{t.notNew.nutriSince}</div>
    </div>

    <div class="text-center">
      <div
        class="mx-auto mb-2.5 flex h-[56px] w-[96px] flex-col items-center justify-center rounded-[3px] border-[1.5px] border-ink"
        aria-hidden="true"
      >
        <span class="text-[15px] font-bold">CO₂</span>
        <span class="text-[11px] text-muted">92 kg</span>
      </div>
      <div class="text-[13px] font-semibold">{t.notNew.flightLabel}</div>
      <div class="text-[13px] text-muted">{t.notNew.flightSince}</div>
    </div>
  </div>
</section>
