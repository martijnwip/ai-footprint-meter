---
import { useTranslations } from '../i18n/utils';

interface Props {
  label?: string;
}
const t = useTranslations(Astro.currentLocale);
const { label = t.beats.ariaLabel } = Astro.props;
---

<section
  aria-label={label}
  class="section-wrap flex min-h-[26vh] items-end justify-start "
>
  <p class="beat-text m-0 mb-6 max-w-[66ch]"><slot /></p>
</section>
