---
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
---

<section aria-label={t.afterMath.ariaLabel} class="section-wrap pt-7">
  <p class="mt-0 mb-[22px] body-text">{t.afterMath.p1}</p>
  <p class="mt-0 mb-[22px] body-text">
    {t.afterMath.p2}
  </p>
  <p class="m-0 body-text">
    {t.afterMath.p3}
  </p>
</section>
