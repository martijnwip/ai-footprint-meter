---
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
---

<section aria-label={t.theAsk.ariaLabel} class="section-wrap py-[clamp(56px,10vw,96px)]">
  <h2 class="h2-title mt-0 mb-[26px]">{t.theAsk.heading}</h2>

  <p class="mt-0 mb-6 body-text">
    {t.theAsk.introPrefix}<strong>{t.theAsk.introStrong}</strong>
  </p>

  <ul class="mt-0 mb-8 list-disc pl-[22px] body-text">
    {t.theAsk.asks.map((ask, index) => <li class={index === t.theAsk.asks.length - 1 ? '' : 'mb-2.5'}>{ask}</li>)}
  </ul>

  <p class="mt-0 mb-[22px] body-text">
    <strong>{t.theAsk.whoLabel}</strong> {t.theAsk.whoText}
  </p>
  <p class="mt-0 mb-4 body-text">
    <strong>{t.theAsk.whyLabel}</strong> {t.theAsk.whyText}
  </p>
  <p class="m-0 body-text">{t.theAsk.conclusion}</p>
</section>
