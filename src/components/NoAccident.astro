---
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
---

<section aria-label={t.noAccident.ariaLabel} class="section-wrap ">
  <h2 class="h2-title mt-0 mb-[26px]">{t.noAccident.heading}</h2>

  <p class="mt-0 mb-[22px] body-text">
    {t.noAccident.p1}
  </p>
  <p class="mt-0 mb-[22px] body-text">
    {t.noAccident.p2}
  </p>
  <p class="mt-0 mb-8 body-text">
    {t.noAccident.p3}
  </p>

  {
    t.noAccident.quotes.map((quote, index) => (
      <blockquote class={`m-0 border-l-2 border-line pl-5 ${index === t.noAccident.quotes.length - 1 ? 'mb-8' : 'mb-[22px]'}`}>
        <p class="mt-0 mb-2 text-[20px] leading-[1.5] italic">{quote.text}</p>
        <p class="m-0 text-[14px] text-muted">{quote.source}</p>
      </blockquote>
    ))
  }

  <p class="mt-0 mb-[22px] body-text">
    {t.noAccident.p4}
  </p>
  <p class="m-0 body-text">
    {t.noAccident.p5}
  </p>
</section>
