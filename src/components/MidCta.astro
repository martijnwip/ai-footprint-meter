---
import { formatCount } from '../lib/count';

interface Props {
  count: number;
}
const { count } = Astro.props;
---

<section aria-label="Tussen-CTA" class="section-wrap py-[clamp(48px,8vw,80px)] text-left">
  <p class="mt-0 mb-7 max-w-[66ch] text-[25px] leading-[1.34] font-bold">
    Wij vragen de EU om AI-aanbieders te verplichten het energieverbruik van elk chat te tonen.
  </p>

  <a href="#tekenen" class="btn-dark hover:bg-ink-hover hover:text-paper">Teken de oproep</a>

  {/* Verborgen zolang de teller nog op nul staat; het script haalt hem daarna op. */}
  <p class="mt-4 mb-0 text-[14px] text-muted" data-count-line hidden={count === 0}>
    <span data-signature-count>{formatCount(count)}</span> mensen gingen je voor
  </p>
</section>
