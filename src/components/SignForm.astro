---
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'nl';
---

<section id="tekenen" aria-label={t.signForm.heading} class="section-wrap scroll-mt-6 py-[clamp(56px,10vw,96px)]">
  <div
    class="max-w-[480px] rounded-md border border-line bg-card p-[clamp(24px,4vw,40px)]"
    data-form-card
  >
    <h2 class="mt-0 mb-[22px] text-[25px] leading-[1.28] font-bold">
      {t.signForm.heading}
    </h2>

    <form method="post" action="/api/sign" data-sign-form novalidate>
      <label for="naam" class="mb-1.5 block text-[14px] font-semibold">{t.signForm.nameLabel}</label>
      <input
        id="naam"
        name="name"
        type="text"
        required
        autocomplete="name"
        maxlength="120"
        class="mb-4 w-full rounded border border-line bg-paper px-3.5 py-3 text-[16px] text-ink focus:border-ink focus:outline-2 focus:outline-offset-1 focus:outline-ink"
      />

      <label for="email" class="mb-1.5 block text-[14px] font-semibold">{t.signForm.emailLabel}</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        maxlength="200"
        class="mb-[18px] w-full rounded border border-line bg-paper px-3.5 py-3 text-[16px] text-ink focus:border-ink focus:outline-2 focus:outline-offset-1 focus:outline-ink"
      />

      <label class="mb-[22px] flex cursor-pointer items-start gap-2.5 text-[14px] text-muted">
        <input
          type="checkbox"
          name="newsletter"
          value="ja"
          class="mt-0.5 h-4 w-4 shrink-0 accent-ink"
        />
        <span>{t.signForm.newsletterLabel}</span>
      </label>

      <!-- Spamval: onzichtbaar voor mensen, ingevuld door bots -->
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="website">{t.signForm.honeypotLabel}</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="renderedAt" data-rendered-at value="" />
      <input type="hidden" name="lang" value={locale} />

      <p
        class="mb-3 hidden text-[14px] leading-[1.5] text-accent"
        data-form-error
        role="alert"
      >
      </p>

      <button
        type="submit"
        class="btn-dark mb-3.5 w-full px-6 hover:bg-ink-hover disabled:opacity-60"
        data-submit
      >
        {t.signForm.submit}
      </button>

      <p class="m-0 text-[14px] leading-[1.5] text-muted">
        {t.signForm.privacyPrefix} <a href="/privacy" class="text-[14px]">{t.signForm.privacyLink}</a>
      </p>
    </form>
  </div>
</section>

<script>
  import { initBotId } from 'botid/client/core';

  initBotId({
    protect: [{ path: '/api/sign', method: 'POST' }],
  });
</script>

<script is:inline define:vars={{ t: t.signForm, contactEmail: 'aifootprintmeter@proton.me' }}>
  const card = document.querySelector('[data-form-card]');
  const form = document.querySelector('[data-sign-form]');
  const errorBox = document.querySelector('[data-form-error]');
  const submit = document.querySelector('[data-submit]');
  const renderedAt = document.querySelector('[data-rendered-at]');

  if (renderedAt) renderedAt.value = String(Date.now());

  function showError(message) {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (event) => {
    if (!form.reportValidity()) {
      event.preventDefault();
      return;
    }

    event.preventDefault();
    errorBox?.classList.add('hidden');
    if (submit) {
      submit.disabled = true;
      submit.textContent = t.submitting;
    }

    const data = Object.fromEntries(new FormData(form).entries());

    try {
      const response = await fetch('/api/sign', {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (!response.ok) {
        showError(t.errors[result.error] ?? t.errors.GENERIC);
        if (submit) {
          submit.disabled = false;
          submit.textContent = t.submit;
        }
        return;
      }

      if (card) {
        card.innerHTML = `
          <h2 class="mt-0 mb-3.5 text-[25px] leading-[1.28] font-bold">${t.successHeading}</h2>
          <p class="mt-0 mb-[22px] body-text">${t.successBody}</p>
          <p class="m-0 text-[14px] leading-[1.5] text-muted">${t.successHelpPrefix} <a href="mailto:${contactEmail}">${contactEmail}</a>.</p>
        `;
        card.setAttribute('tabindex', '-1');
        card.focus();
      }
    } catch {
      showError(t.errors.NETWORK);
      if (submit) {
        submit.disabled = false;
        submit.textContent = t.submit;
      }
    }
  });
</script>
