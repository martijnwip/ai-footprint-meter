---
import Base from '../../layouts/Base.astro';
import StickyBar from '../../components/StickyBar.astro';
import { useTranslations, getLocalizedPath, isLocale } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const currentLocale = isLocale(Astro.currentLocale) ? Astro.currentLocale : 'nl';
const homeHref = getLocalizedPath('/', currentLocale, currentLocale);
---

<Base title={t.seo.bijnaKlaarTitle} description={t.seo.bijnaKlaarDescription} noindex>
  <StickyBar />

  <main class="section-wrap flex min-h-screen flex-col justify-center py-24">
    <h1 class="mt-0 mb-4 text-[clamp(26px,4.6vw,34px)] leading-[1.18] font-bold">
      {t.bijnaKlaar.heading}
    </h1>
    <p class="mt-0 mb-6 max-w-[66ch] body-text">
      {t.bijnaKlaar.body}
    </p>
    <p class="mt-0 mb-10 max-w-[66ch] text-[14px] leading-[1.5] text-muted">
      {t.bijnaKlaar.helpPrefix} <a href="mailto:aifootprintmeter@proton.me"
        >aifootprintmeter@proton.me</a
      >.
    </p>
    <p class="m-0"><a href={homeHref}>{t.bijnaKlaar.back}</a></p>
  </main>
</Base>
