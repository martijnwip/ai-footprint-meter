---
import Base from '../../layouts/Base.astro';
import StickyBar from '../../components/StickyBar.astro';
import { useTranslations, getLocalizedPath, isLocale } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const currentLocale = isLocale(Astro.currentLocale) ? Astro.currentLocale : 'nl';
const homeHref = getLocalizedPath('/', currentLocale, currentLocale);
---

<Base title={t.seo.privacyTitle} description={t.seo.privacyDescription}>
  <StickyBar />

  <main class="section-wrap py-[clamp(72px,12vw,120px)]">
    <h1 class="mt-0 mb-8 text-[clamp(26px,4.6vw,34px)] leading-[1.18] font-bold">
      {t.privacy.heading}
    </h1>

    <p class="mt-0 mb-6 body-text">
      {t.privacy.concept}
    </p>

    <h2 class="h2-title mt-10 mb-4">{t.privacy.storedHeading}</h2>
    <ul class="mt-0 mb-6 list-disc pl-[22px] body-text">
      {t.privacy.stored.map((item, index) => (
        <li class={index === t.privacy.stored.length - 1 ? '' : 'mb-2.5'}>{item}</li>
      ))}
    </ul>

    <h2 class="h2-title mt-10 mb-4">{t.privacy.whereHeading}</h2>
    <p class="mt-0 mb-6 body-text">
      {t.privacy.whereText}
    </p>

    <h2 class="h2-title mt-10 mb-4">{t.privacy.purposeHeading}</h2>
    <p class="mt-0 mb-6 body-text">
      {t.privacy.purposeText}
    </p>

    <h2 class="h2-title mt-10 mb-4">{t.privacy.durationHeading}</h2>
    <p class="mt-0 mb-6 body-text">
      {t.privacy.durationText}
    </p>

    <h2 class="h2-title mt-10 mb-4">{t.privacy.deleteHeading}</h2>
    <p class="mt-0 mb-6 body-text">
      {t.privacy.deletePrefix} <a href="mailto:aifootprintmeter@proton.me">aifootprintmeter@proton.me</a>.
    </p>

    <p class="mt-10 mb-0"><a href={homeHref}>{t.privacy.back}</a></p>
  </main>
</Base>
