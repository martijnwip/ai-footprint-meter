---
import Base from '../../layouts/Base.astro';
import StickyBar from '../../components/StickyBar.astro';
import { useTranslations, getLocalizedPath, isLocale } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const currentLocale = isLocale(Astro.currentLocale) ? Astro.currentLocale : 'nl';
const homeHref = getLocalizedPath('/', currentLocale, currentLocale);
const homeUrl = new URL(homeHref, Astro.url.origin).href;
const shareHref = `mailto:?subject=${encodeURIComponent(t.bevestigd.shareSubject)}&body=${encodeURIComponent(t.bevestigd.shareBody)}`;
---

<Base
  title={t.seo.bevestigdTitle}
  description={t.seo.bevestigdDescription}
  noindex
>
  <StickyBar />

  <main class="section-wrap flex min-h-screen flex-col justify-center py-24">
    <h1
      class="mt-0 mb-4 text-[clamp(26px,4.6vw,34px)] leading-[1.18] font-bold"
      data-title
    >
      {t.bevestigd.okHeading}
    </h1>
    <p class="mt-0 mb-8 max-w-[66ch] body-text" data-body>
      {t.bevestigd.okBody}
    </p>

    <div class="mb-10 flex flex-wrap gap-2.5" data-share>
      <button
        type="button"
        class="btn-dark px-5 py-3 text-[15px] hover:bg-ink-hover"
        data-copy
        data-url={homeUrl}
      >
        {t.bevestigd.copy}
      </button>
      <a href={shareHref} class="self-center text-[15px] font-semibold">{t.bevestigd.shareEmail}</a>
    </div>

    <p class="m-0"><a href={homeHref}>{t.bevestigd.back}</a></p>
  </main>

  <script
    is:inline
    define:vars={{
      t: t.bevestigd,
    }}
  >
    const params = new URLSearchParams(window.location.search);
    const status = params.get('status');
    const title = document.querySelector('[data-title]');
    const body = document.querySelector('[data-body]');
    const share = document.querySelector('[data-share]');

    if (status === 'al' && title && body) {
      title.textContent = t.alHeading;
      body.textContent = t.alBody;
    }

    if (status === 'ongeldig' && title && body) {
      title.textContent = t.ongeldigHeading;
      body.textContent = t.ongeldigBody;
      share?.remove();
    }

    const copyButton = document.querySelector('[data-copy]');
    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyButton.dataset.url ?? window.location.href);
        copyButton.textContent = t.copied;
        setTimeout(() => {
          copyButton.textContent = t.copy;
        }, 2000);
      } catch {
        copyButton.textContent = t.copyFailed;
      }
    });
  </script>
</Base>
