---
import Base from '../../layouts/Base.astro';
import StickyBar from '../../components/StickyBar.astro';
import Hero from '../../components/Hero.astro';
import ChatMockup from '../../components/ChatMockup.astro';
import EveningSum from '../../components/EveningSum.astro';
import AfterMath from '../../components/AfterMath.astro';
import Beat from '../../components/Beat.astro';
import NoAccident from '../../components/NoAccident.astro';
import NotNew from '../../components/NotNew.astro';
import MidCta from '../../components/MidCta.astro';
import TheAsk from '../../components/TheAsk.astro';
import SignForm from '../../components/SignForm.astro';
import Objections from '../../components/Objections.astro';
import WhoWeAre from '../../components/WhoWeAre.astro';
import Timeline from '../../components/Timeline.astro';
import { fetchConfirmedCountSafe } from '../../lib/count';
import { useTranslations } from '../../i18n/utils';

// Getal komt uit de build; de browser ververst het daarna via /api/count.
const count = await fetchConfirmedCountSafe();
const t = useTranslations(Astro.currentLocale);
---

<Base title={t.seo.homeTitle} description={t.seo.homeDescription}>
  <StickyBar />

  <main>
    <Hero />
    <ChatMockup />
    <EveningSum />
    <AfterMath />
    <Beat label={t.beats.ariaLabel}>{t.beats.beat1}</Beat>
    <NoAccident />
    <NotNew />
    <Beat label={t.beats.ariaLabel}>
      {t.beats.beat2}
    </Beat>
    <MidCta count={count} />
    <TheAsk />
    <SignForm />
    <Objections />
    <WhoWeAre />
    <Timeline />
  </main>

  <script is:inline define:vars={{ locale: Astro.currentLocale ?? 'nl' }}>
    // Teller bijwerken zonder de pagina server-side te renderen.
    const NUMBER_LOCALES = { nl: 'nl-NL', en: 'en-GB', de: 'de-DE', fr: 'fr-FR', es: 'es-ES' };
    const targets = document.querySelectorAll('[data-signature-count]');
    if (targets.length) {
      fetch('/api/count')
        .then((response) => (response.ok ? response.json() : null))
        .then((data) => {
          if (!data || typeof data.count !== 'number' || data.count === 0) return;
          const formatted = new Intl.NumberFormat(NUMBER_LOCALES[locale] ?? 'nl-NL').format(data.count);
          targets.forEach((node) => {
            node.textContent = formatted;
          });
          document
            .querySelectorAll('[data-count-line]')
            .forEach((line) => line.removeAttribute('hidden'));
        })
        .catch(() => {
          /* Getal uit de build blijft staan */
        });
    }
  </script>
</Base>
